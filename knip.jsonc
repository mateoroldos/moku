{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip cannot follow member access through self-named namespace exports.
  "exclude": ["exports", "types"],
  "workspaces": {
    "adapters/database-postgres": {
      "entry": ["src/**/*.test.ts"],
    },
    ".": {
      "entry": ["scripts/*.ts"],
      // Pinned CLI used by the svelte-code-writer skill.
      "ignoreDependencies": ["@sveltejs/mcp"],
    },
    "apps/web": {
      "entry": ["auth.config.ts"],
      // @shadcn/lint builds the app theme with the app's own Tailwind.
      "ignoreDependencies": ["tailwindcss"],
    },
    "packages/ui": {
      // svelte-check selects the TypeScript 7 alias through --tsgo.
      "ignoreDependencies": ["@typescript/native"],
    },
  },
}
