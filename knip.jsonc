{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip cannot follow member access through self-named namespace exports.
  "exclude": ["exports", "types"],
  "workspaces": {
    "adapters/database-postgres": {
      "entry": ["src/**/*.test.ts"],
    },
    ".": {
      "entry": ["scripts/*.ts"],
    },
    "packages/ui": {
      // svelte-check selects the TypeScript 7 alias through --tsgo.
      "ignoreDependencies": ["@typescript/native"],
    },
  },
}
