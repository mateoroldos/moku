{
  "name": "@moku/database-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/persistence-postgres.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
