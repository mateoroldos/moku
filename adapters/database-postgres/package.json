    "pg": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@types/pg": "8.20.0",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
