# Local Docker database. Set a PostgreSQL/Neon connection URL for other environments.
DATABASE_URL=postgresql://moku:moku@127.0.0.1:54329/moku
# Public origin embedded when building the Node server (Kit 3 paths.origin).
ORIGIN=http://127.0.0.1:3000
# Exact public auth origin for bun run dev; override for the built server.
AUTH_ORIGIN=http://127.0.0.1:5173
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional OTLP HTTP base URL. dev:otel sets this for the local viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
