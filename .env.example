# Local Docker database. Set a PostgreSQL/Neon connection URL for other environments.
DATABASE_URL=postgresql://moku:moku@127.0.0.1:54329/moku
# Browser origin: must match at build and startup, including scheme, host, and port.
ORIGIN=http://localhost:5173
# Generate a private value with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# invite-only (the default) admits invited emails and SIGNUP_EMAILS; public admits anyone.
SIGNUP_MODE=public
# Comma-separated emails that can sign up while invite-only, such as the first operator's.
# SIGNUP_EMAILS=operator@example.com
# Local-only email links in the server terminal. Defaults to cloudflare when unset.
EMAIL_DELIVERY=console
# Cloudflare delivery requires all three values; use a verified sending domain.
# EMAIL_FROM=hello@example.com
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional OTLP HTTP base URL. dev:otel sets this for the local viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
