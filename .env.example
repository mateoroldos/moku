# Local Docker database. Set a PostgreSQL/Neon connection URL for other environments.
DATABASE_URL=postgresql://moku:moku@127.0.0.1:54329/moku
# Exact browser origin, including port; use the same value for build and startup.
ORIGIN=http://127.0.0.1:5173
# Required: generate with `openssl rand -base64 32` and keep private.
BETTER_AUTH_SECRET=
# Set privately when running auth:seed; repeated runs preserve existing passwords.
# SEED_EMAIL=reviewer@example.com
# SEED_PASSWORD=
# Optional OTLP HTTP base URL. dev:otel sets this for the local viewer.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
