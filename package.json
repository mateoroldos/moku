{
  "name": "moku",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run check:guidance && bun run check:workspaces && bun run knip && bun run check-types && bun run test",
    "check:guidance": "bun scripts/check-guidance.ts",
    "check:workspaces": "bun scripts/check-workspaces.ts",
    "check-types": "tsc --noEmit && turbo check-types",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "effect-tsgo patch --oxlint",
    "skills": "skills",
    "test": "turbo test && vitest run scripts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.3.14",
    "effect": "catalog:",
    "knip": "6.33.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "skills": "1.7.0",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "vitest": "4.1.11"
  }
}
