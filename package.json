{
  "name": "moku",
  "private": true,
  "workspaces": [
    "adapters/*",
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun run --cwd adapters/database-postgres db:generate",
    "db:migrate": "bun run --cwd adapters/database-postgres db:migrate",
    "test:postgres": "bun run --cwd adapters/database-postgres test:postgres",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run check:guidance && bun run check:workspaces && bun run db:check && bun run knip && bun run check-types && bun run test",
    "db:check": "bun scripts/check-migrations.ts",
    "check:guidance": "bun scripts/check-guidance.ts",
    "check:workspaces": "bun scripts/check-workspaces.ts",
    "check-types": "tsc --noEmit && turbo check-types",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "effect-tsgo patch --oxlint",
    "skills": "skills",
    "test": "turbo test && vitest run scripts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.36.5",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.3.14",
    "effect": "catalog:",
    "knip": "6.33.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "skills": "1.7.0",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/sql-pglite": "4.0.0-rc.112",
    "@electric-sql/pglite": "0.5.7",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "pg": "8.23.0",
    "@tailwindcss/vite": "4.3.3",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "vitest": "4.1.11"
  }
}
