{
  "name": "@moku/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "db:seed": "bun --env-file=../../.env src/seed.ts",
    "auth:seed": "bun --env-file=../../.env src/seed.ts --account-only",
    "auth:generate": "auth generate --config ./auth.config.ts --output ../../adapters/database-postgres/src/auth/schema.ts --yes && bun run --cwd ../.. oxfmt adapters/database-postgres/src/auth/schema.ts",
    "start": "node --env-file-if-exists=../../.env build/index.js",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev --host localhost --port 5173 --strictPort",
    "build": "vite build",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@moku/core": "workspace:*",
    "@moku/database-postgres": "workspace:*",
    "@moku/domain": "workspace:*",
    "@moku/email-cloudflare": "workspace:*",
    "@moku/ui": "workspace:*",
    "effect": "catalog:",
    "mode-watcher": "catalog:",
    "phosphor-svelte": "catalog:",
    "svelte-sonner": "catalog:"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.4",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@effect/vitest": "catalog:",
    "@sveltejs/adapter-node": "6.0.0-next.15",
    "@sveltejs/kit": "3.0.0-next.30",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "catalog:",
    "auth": "1.7.4",
    "better-auth": "1.7.4",
    "drizzle-orm": "catalog:",
    "eslint": "10.11.0",
    "nanoid": "3.3.19",
    "svelte": "catalog:",
    "svelte-check": "4.7.6",
    "tailwindcss": "catalog:",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "catalog:"
  }
}
