{
  "name": "@moku/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "db:seed": "bun --env-file=../../.env src/seed.ts",
    "start": "node --env-file-if-exists=../../.env build/index.js",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev --host 127.0.0.1",
    "build": "vite build",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@moku/core": "workspace:*",
    "@moku/database-postgres": "workspace:*",
    "@moku/domain": "workspace:*",
    "@moku/ui": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "mode-watcher": "1.1.0",
    "pg": "catalog:",
    "phosphor-svelte": "3.1.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@sveltejs/adapter-node": "6.0.0-next.15",
    "@sveltejs/kit": "3.0.0-next.30",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "catalog:",
    "@types/pg": "8.20.0",
    "svelte": "catalog:",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "catalog:"
  }
}
