{
  "name": "@moku/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./cn": "./src/cn/cn.ts",
    "./cn.js": "./src/cn/cn.ts",
    "./eslint.config.js": "./eslint.config.js",
    "./theme.css": "./src/theme.css",
    "./hooks/*.svelte.js": "./src/hooks/*.svelte.ts",
    "./ui/*": "./src/ui/*/index.ts",
    "./ui/*/index.js": "./src/ui/*/index.ts"
  },
  "scripts": {
    "check-types": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json",
    "lint": "eslint"
  },
  "dependencies": {
    "bits-ui": "2.18.0",
    "clsx": "2.1.1",
    "mode-watcher": "catalog:",
    "phosphor-svelte": "catalog:",
    "svelte-sonner": "catalog:",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@typescript-eslint/parser": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-oxlint": "1.78.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte": "catalog:",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "svelte": ">=5"
  }
}
