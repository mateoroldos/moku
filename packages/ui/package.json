{
  "name": "@moku/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./cn": "./src/cn/cn.ts",
    "./cn.js": "./src/cn/cn.ts",
    "./theme.css": "./src/theme.css",
    "./ui/*": "./src/ui/*/index.ts",
    "./ui/*/index.js": "./src/ui/*/index.ts"
  },
  "scripts": {
    "check-types": "svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "catalog:",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "svelte": ">=5"
  }
}
